+              PreferenceDivider()
+              ValuePreference(
+                title = stringResource(R.string.pref_extra_maximum_network_download_title),
+                summary = if (maximumNetworkDownloadMiB == 0) {
+                  stringResource(R.string.pref_extra_size_threshold_disabled)
