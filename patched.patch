+                  stringResource(R.string.pref_extra_mib_value, maximumNetworkDownloadMiB)
+                },
+                onClick = {
+                  numberDialog =
+                    NumberSetting(
+                      R.string.pref_extra_maximum_network_download_title,
+                      maximumNetworkDownloadMiB,
